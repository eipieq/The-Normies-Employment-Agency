# copy to .env.local and fill in values. .env.local is gitignored.
# bootstrap: cp .env.example .env.local

# venice ai: openai-compatible api at https://api.venice.ai/api/v1
# get a key at https://venice.ai/settings/api
VENICE_API_KEY=

# walletconnect project id for rainbowkit (phase 5+)
# https://cloud.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=

# session secret for iron-session siwe cookie (phase 5+)
# generate: openssl rand -base64 32
SESSION_SECRET=

# upstash redis for persona cache (auto-provisioned via vercel marketplace)
# vercel integration add upstash/upstash-kv
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ethereum mainnet rpc for azuki on-chain reads (optional, defaults to publicnode)
# MAINNET_RPC_URL=

# alchemy credentials for azuki metadata + roster (dev falls back to alchemy demo key).
# set EITHER the bare key or the full rpc url — the key is parsed out of the url.
# without one of these, azuki images fall back to the public ipfs.io gateway,
# which is rate-limited and frequently fails to load.
# https://dashboard.alchemy.com/
ALCHEMY_API_KEY=
# ALCHEMY_API_URL=https://eth-mainnet.g.alchemy.com/v2/<key>

# nowpayments — crypto subscription payments (https://nowpayments.io)
# 1. create account, get API key from dashboard
# 2. generate IPN secret in dashboard → Payments → IPN
# 3. create plan once: POST /v1/subscriptions/plans (or via dashboard)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PLAN_ID=

# eas on base (ethereum attestation service)
# register schema at https://base.easscan.org/schema/create
# schema: uint256 tokenId, string collection, bytes32 decisionHash
NEXT_PUBLIC_EAS_CONTRACT=0x4200000000000000000000000000000000000021
NEXT_PUBLIC_EAS_SCHEMA_UID=

# public base url — for nowpayments ipn callback + redirect urls
NEXT_PUBLIC_URL=https://yourdomain.com
