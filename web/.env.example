# copy to .env.local and fill in values. .env.local is gitignored.
# bootstrap: cp .env.example .env.local

# venice ai: openai-compatible api at https://api.venice.ai/api/v1
# get a key at https://venice.ai/settings/api
VENICE_API_KEY=

# walletconnect project id for rainbowkit (phase 5+)
# https://cloud.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=

# session secret for iron-session siwe cookie (phase 5+)
# generate: openssl rand -base64 32
SESSION_SECRET=

# vercel kv (phase 3+ for persona cache, optional for local dev)
# pull these via `vercel env pull .env.local` after linking
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
